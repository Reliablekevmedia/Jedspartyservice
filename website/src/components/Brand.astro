---
// Jed's logo, traced from the original artwork.
// Default: "JED'S PARTY SERVICES" reading across on one line (header, home hero).
// framed: the original boxed logo, exactly as Jed has it.
import { LOGO } from '../brand';

interface Props {
  framed?: boolean;
  tag?: 'a' | 'span';
  class?: string;
}
const { framed = false, tag = 'a', class: className } = Astro.props;
const Tag = tag;
const link = tag === 'a' ? { href: '/', 'aria-label': "Jed's Party Services, home" } : { 'aria-hidden': 'true' };
---

{framed ? (
  <Tag class:list={['brand', 'brand--framed', className]} {...link}>
    <svg class="brand__full" viewBox={`0 0 ${LOGO.full.w} ${LOGO.full.h}`} aria-hidden="true"><use href="#logo-full" /></svg>
  </Tag>
) : (
  <Tag class:list={['brand', className]} {...link}>
    <svg class="brand__jeds" viewBox={`0 0 ${LOGO.jeds.w} ${LOGO.jeds.h}`} aria-hidden="true"><use href="#logo-jeds" /></svg>
    <svg class="brand__sub" viewBox={`0 0 ${LOGO.sub.w} ${LOGO.sub.h}`} aria-hidden="true"><use href="#logo-sub" /></svg>
  </Tag>
)}
