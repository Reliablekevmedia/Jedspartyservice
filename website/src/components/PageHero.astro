---
import { glassViewBox } from '../brand';

interface Props {
  lede?: string;
}
const { lede } = Astro.props;
---

<section class="page-hero surface-dark" aria-labelledby="page-title">
  <svg class="hero__watermark" viewBox={glassViewBox} aria-hidden="true"><use href="#i-martini" /></svg>
  <div class="wrap">
    <h1 id="page-title" class="reveal"><slot /></h1>
    {lede && <p class="lede reveal" data-delay="2">{lede}</p>}
  </div>
</section>
