---
import { url } from '../url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icons from '../components/Icons.astro';
import Intro from '../components/Intro.astro';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
}

const { title, description = SITE.description, noindex = false, home = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | Bartenders & Event Staff in Northern NJ`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url('/og-image.jpg'), Astro.site);
// Preview builds (GitHub Pages) stay out of search results until the real domain is live.
const preview = import.meta.env.PUBLIC_PREVIEW === 'true';
---

<!doctype html>
<html lang="en" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Play the opening pour once per visit (skipped for reduced-motion users).
      (function () {
        if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        try {
          if (sessionStorage.getItem('jps-intro')) return;
          sessionStorage.setItem('jps-intro', '1');
        } catch (e) {}
        document.documentElement.classList.add('intro');
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0a09" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="preload" href={url('/fonts/cormorant-garamond-latin-500-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/jost-latin-300-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class:list={{ 'is-home': home }}>
    <Icons />
    <Intro />
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  document.documentElement.classList.remove('no-js');

  // Fade sections in as they scroll into view (after the opening pour, if it is playing).
  const reveals = document.querySelectorAll('.reveal');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const startReveals = () => {
  if (!('IntersectionObserver' in window) || reduce) {
    reveals.forEach((el) => el.classList.add('is-in'));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          }
        });
      },
      { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
    );
    reveals.forEach((el) => io.observe(el));
  }
  };
  if (document.documentElement.classList.contains('intro')) {
    let started = false;
    const go = () => {
      if (!started) { started = true; startReveals(); }
    };
    document.addEventListener('intro:done', go, { once: true });
    window.setTimeout(go, 4200);
  } else {
    startReveals();
  }
</script>
