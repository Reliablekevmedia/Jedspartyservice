---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BarTop from '../components/BarTop.astro';
import Cta from '../components/Cta.astro';
import Icon from '../components/Icon.astro';
import Martini from '../components/Martini.astro';
import { RATES, SITE } from '../site';

const counties = (await getCollection('counties')).sort((a, b) => a.data.order - b.data.order);

const services = [
  {
    icon: 'martini',
    title: 'Bartending',
    rate: `$${RATES.bartender} per hour`,
    text: 'Bar setup with mixers, garnish and ice. Full bar service, from cocktails to wine, beer and champagne. Glassware and back-bar cleanup at the end of the night.',
    link: { href: '/services#bartenders', label: 'Bar service' },
  },
  {
    icon: 'cloche',
    title: 'Food Service',
    rate: `$${RATES.server} per hour`,
    text: 'Party prep and table setup, cocktail-hour hors d’oeuvres, dinner and dessert service, then a complete cleanup of dishes, floors, rentals and garbage.',
    link: { href: '/services#servers', label: 'Server service' },
  },
  {
    icon: 'clipboard',
    title: 'Event Coordination',
    rate: 'For larger celebrations',
    text: 'For parties with six or more staff, an event coordinator keeps the timeline, the team and every detail running smoothly from the first guest to the last.',
    link: { href: '/services#staffing', label: 'Staffing guide' },
  },
];

const occasions = [
  'Weddings & Engagements', 'Showers', 'Anniversaries', 'Bar & Bat Mitzvahs', 'Sweet Sixteens',
  'Birthdays', 'Graduations', 'Retirements', 'Company & Holiday Parties',
];

const steps = [
  {
    title: 'Free consultation',
    text: 'Call, email or send an event request. Phone and email consultations are free; we learn your party’s needs before pricing and scheduling are set.',
  },
  {
    title: 'Reserve your date',
    text: `A ${RATES.depositPercent}% non-refundable deposit holds your event date. The ${100 - RATES.depositPercent}% balance is due within ${RATES.balanceDueHours} hours of your event.`,
  },
  {
    title: 'Enjoy your party',
    text: 'We arrive to set up, serve your guests with polish and a smile, then clean up, so the end of the night is as easy as the start.',
  },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: SITE.name,
  description: SITE.description,
  url: Astro.site?.href,
  image: new URL('/og-image.jpg', Astro.site).href,
  logo: new URL('/favicon.svg', Astro.site).href,
  telephone: '+1-201-538-7276',
  email: SITE.email,
  founder: { '@type': 'Person', name: SITE.owner },
  address: { '@type': 'PostalAddress', addressLocality: SITE.city, addressRegion: SITE.state, postalCode: SITE.zip, addressCountry: 'US' },
  areaServed: counties.map((c) => `${c.data.name}, NJ`),
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '00:00',
    closes: '23:59',
  },
  paymentAccepted: 'Cash, Check',
  makesOffer: [
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Bartender' }, priceSpecification: { '@type': 'UnitPriceSpecification', price: RATES.bartender, priceCurrency: 'USD', unitText: 'hour' } },
    { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Server' }, priceSpecification: { '@type': 'UnitPriceSpecification', price: RATES.server, priceCurrency: 'USD', unitText: 'hour' } },
  ],
};
---

<Base>
  <Fragment slot="head"><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} /></Fragment>

  <section class="hero surface-dark" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__tagline reveal">Going the extra mile <em>leaves a lifelong impression.</em></h1>
        <p class="lede reveal" data-delay="2">Polished bartenders and servers for weddings, milestones and gatherings across Northern New Jersey. We treat your special occasion as we would our own.</p>
        <div class="btn-row reveal" data-delay="3">
          <a class="btn btn--light" href="/contact">Request Your Date</a>
          <a class="btn btn--ghost" href={`tel:${SITE.phoneTel}`}><Icon name="phone" />{SITE.phone}</a>
        </div>
      </div>
      <figure class="arch hero__media reveal" data-delay="2">
        <img src="/img/toast.jpg" width="823" height="800" fetchpriority="high" alt="Two guests raise glasses of whiskey in a toast at the bar" />
      </figure>
    </div>
  </section>
  <BarTop />

  <section class="section mission" aria-labelledby="mission-title">
    <div class="wrap split split--wide-left">
      <div>
        <h2 id="mission-title" class="reveal">We treat your special occasion as we would <em>our own.</em></h2>
        <div class="reveal" data-delay="1">
          <p>It is our goal to go the extra mile and leave a lifelong impression on those we serve. {SITE.name} specializes in small and large parties, hosted in your home or at another venue.</p>
          <p>We offer a wide range of services to fit your needs, including food service, bartending and event coordination. Our professional servers and bartenders bring years of experience in the service industry. We give nothing less than perfection and a smile.</p>
        </div>
      </div>
      <figure class="frame reveal" data-delay="1" style="max-width:400px;justify-self:center">
        <div class="frame__img"><img src="/img/jed-portrait.jpg" width="325" height="432" loading="lazy" alt="Jed Kessler smiling behind a candlelit bar he set up for a 30th birthday party" /></div>
      </figure>
    </div>
  </section>

  <section class="section surface-bone" aria-labelledby="services-title">
    <div class="wrap">
      <div class="section-head">
        <div class="divider reveal" aria-hidden="true"><Martini /></div>
        <h2 id="services-title" class="reveal">Service, poured and plated <em>with care</em></h2>
      </div>
      <div class="cards">
        {services.map((s, i) => (
          <article class="card inlay reveal" data-delay={i || undefined}>
            <div class="card__icon">
              {s.icon === 'martini' ? <Martini /> : <svg viewBox="0 0 48 48" aria-hidden="true"><use href={`#i-${s.icon}`} /></svg>}
            </div>
            <h3>{s.title}</h3>
            <p class="card__rate">{s.rate}</p>
            <p>{s.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section craft surface-dark" id="craft" aria-labelledby="craft-title">
    <div class="wrap split">
      <div class="craft__media reveal">
        <img src="/img/vintage-bar.jpg" width="1600" height="1200" loading="lazy" alt="Jed and a fellow bartender lean out of a custom wooden bar trailer with barn-door shutters" />
        <div class="craft__plank" aria-hidden="true"></div>
      </div>
      <div>
        <h2 id="craft-title" class="reveal">Every great pour deserves a <em>handcrafted bar.</em></h2>
        <p class="lede reveal" data-delay="1">Many of the bars we serve from are custom crafted. Their wood bar tops are built and finished by hand by our craftsman partners, so the bar looks like part of your event instead of a folding table.</p>
        <ul class="craft__list reveal" data-delay="2">
          <li><b>i.</b><span>Custom bar tops in warm, natural wood</span></li>
          <li><b>ii.</b><span>Built and finished by hand</span></li>
          <li><b>iii.</b><span>Vintage and mobile bar setups that suit your venue</span></li>
        </ul>
        <p class="craft__credit reveal" data-delay="3">Custom bar tops by {SITE.barTopPartners}.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="occasions-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="occasions-title" class="reveal">Intimate gatherings &amp; <em>grand celebrations</em></h2>
      </div>
      <ul class="occasions">
        {occasions.map((o, i) => <li class="reveal" data-delay={i % 3}><Martini />{o}</li>)}
      </ul>
    </div>
  </section>

  <section class="section surface-bone" aria-labelledby="process-title">
    <div class="wrap">
      <div class="section-head section-head--left">
        <h2 id="process-title" class="reveal">From first call <em>to last call</em></h2>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="reveal" data-delay={i || undefined}>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <Cta />
</Base>
