---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BarTop from '../components/BarTop.astro';
import Icon from '../components/Icon.astro';
import Martini from '../components/Martini.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../site';

const counties = (await getCollection('counties')).sort((a, b) => a.data.order - b.data.order);
const names = counties.map((c) => c.data.name.replace(' County', ''));

const eventTypes = [
  'Birthday Party', 'Anniversary Party', 'Holiday Party', 'Graduation Party', 'Wedding/Engagement Party',
  'Professional Gathering', 'Retirement Party', 'Other',
];
const services = ['Bartender', 'Server', 'Both'];
---

<Base
  title="Contact & Event Requests"
  description={`Request your event date with ${SITE.name}. Call ${SITE.phone} anytime or send an event request.`}
>
  <PageHero lede="Please call anytime. Voice messages and emails will be returned as soon as possible.">
    Let&rsquo;s plan <em>your event.</em>
  </PageHero>
  <BarTop />

  <section class="section" aria-label="Contact details and event request form">
    <div class="wrap">
      <div class="contact-grid reveal">
        <aside class="contact-card surface-dark" aria-labelledby="talk-title">
          <h2 id="talk-title">Talk with <em>Jed</em></h2>
          <p class="muted">Phone and email consultations are always free of charge.</p>
          <ul class="contact-lines">
            <li><Icon name="phone" /><div><a href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a></div></li>
            <li><Icon name="mail" /><div><a href={`mailto:${SITE.email}`}>{SITE.email}</a></div></li>
            <li><Icon name="clock" /><div><span class="v">{SITE.hours}</span></div></li>
            <li><Icon name="pin" /><div><span class="v">{SITE.city}, {SITE.state} {SITE.zip}</span></div></li>
          </ul>
        </aside>

        <form class="form" data-request-form data-mailto={SITE.email} novalidate aria-labelledby="form-title">
          <h2 id="form-title" class="visually-hidden">Event Request Form</h2>
          <div class="form__grid">
            <div>
              <label for="f-first">First name <span class="req">*</span></label>
              <input id="f-first" name="first" autocomplete="given-name" required />
              <span class="error">Please enter your first name.</span>
            </div>
            <div>
              <label for="f-last">Last name <span class="req">*</span></label>
              <input id="f-last" name="last" autocomplete="family-name" required />
              <span class="error">Please enter your last name.</span>
            </div>
            <div>
              <label for="f-phone">Phone number <span class="req">*</span></label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required />
              <span class="error">Please enter a phone number.</span>
            </div>
            <div>
              <label for="f-email">Email <span class="req">*</span></label>
              <input id="f-email" name="email" type="email" autocomplete="email" required />
              <span class="error">Please enter a valid email address.</span>
            </div>
            <div>
              <label for="f-event">Type of event <span class="req">*</span></label>
              <select id="f-event" name="event" required>
                <option value="">Select one</option>
                {eventTypes.map((e) => <option>{e}</option>)}
              </select>
              <span class="error">Please choose an event type.</span>
            </div>
            <div>
              <label for="f-service">Service <span class="req">*</span></label>
              <select id="f-service" name="service" required>
                <option value="">Select one</option>
                {services.map((s) => <option>{s}</option>)}
              </select>
              <span class="error">Please choose a service.</span>
            </div>
            <div>
              <label for="f-guests">Number of guests <span class="req">*</span></label>
              <input id="f-guests" name="guests" type="number" min="1" inputmode="numeric" required />
              <span class="error">Please enter an approximate guest count.</span>
            </div>
            <div>
              <label for="f-date">Date of event <span class="req">*</span></label>
              <input id="f-date" name="date" required placeholder="Date or month" />
              <span class="error">Please enter a date or month.</span>
            </div>
            <div class="form__full">
              <label for="f-city">City of event <span class="req">*</span></label>
              <input id="f-city" name="city" autocomplete="address-level2" required placeholder="Event city or your city" />
              <span class="error">Please enter a city.</span>
            </div>
            <div class="form__full">
              <label for="f-message">Anything else we should know?</label>
              <textarea id="f-message" name="message" rows="4" placeholder="Venue, timing, bar setup, special requests…"></textarea>
            </div>
          </div>
          <div class="form__actions">
            <button class="btn" type="submit">Send Request <Icon name="arrow" /></button>
          </div>
          <div class="form__status" role="status" tabindex="-1">
            Your email app should now be open with your request ready to send. If it didn&rsquo;t open, email
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call <a href={`tel:${SITE.phoneTel}`}>{SITE.phone}</a>.
          </div>
        </form>
      </div>
    </div>
  </section>
</Base>

<script>
  // Event request form: validate, then open the visitor's email app with the details filled in.
  const form = document.querySelector<HTMLFormElement>('[data-request-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('.form__status');
    const to = form.dataset.mailto ?? '';
    const fields = () => Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]'));
    const v = (name: string) => String((form.elements.namedItem(name) as HTMLInputElement | null)?.value ?? '').trim();

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      let firstInvalid: HTMLElement | null = null;
      for (const field of fields()) {
        const ok = field.checkValidity();
        field.setAttribute('aria-invalid', ok ? 'false' : 'true');
        if (!ok && !firstInvalid) firstInvalid = field;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const name = `${v('first')} ${v('last')}`.trim();
      const subject = `Event Request: ${v('event')} on ${v('date')} (${name})`;
      const body = [
        `Name: ${name}`,
        `Phone: ${v('phone')}`,
        `Email: ${v('email')}`,
        `Type of event: ${v('event')}`,
        `Service: ${v('service')}`,
        `Number of guests: ${v('guests')}`,
        `City of event: ${v('city')}`,
        `Date of event: ${v('date')}`,
        '',
        'Details:',
        v('message') || '(none)',
      ].join('\n');

      window.location.href = `mailto:${to}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      status?.classList.add('is-visible');
      status?.focus();
    });

    form.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.getAttribute('aria-invalid') === 'true' && t.checkValidity()) t.setAttribute('aria-invalid', 'false');
    });
  }
</script>
